{
  "name": "@bob-the-tester/regression-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic MCP server skeleton for regression review tooling",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "tool": "node dist/cli.js tool",
    "review": "node dist/cli.js review",
    "code-review": "node dist/cli.js code-review",
    "unified-review": "node dist/cli.js unified-review",
    "suite": "node dist/cli.js tool generate_playwright_suite",
    "suite:check": "node dist/cli.js tool validate_playwright_suite",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "setup:bobthetester": "bash ../../scripts/setup-bobthetester.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "@playwright/test": "1.58.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "monocart-reporter": "2.10.0",
    "prettier": "^3.8.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.57.2"
  }
}
