{
  "version": 1,
  "git": {
    "defaultBaseRef": "HEAD~1",
    "defaultHeadRef": "HEAD"
  },
  "playwright": {
    "command": "npm",
    "commandArgs": ["exec", "--prefix", "tools/regression-mcp", "--", "playwright"],
    "defaultProject": "chromium",
    "configFile": "sandbox/playwright.config.ts",
    "reportFormat": "json",
    "reportPath": "sandbox/artifacts/playwright/results.json",
    "testResultsDir": "sandbox/test-results",
    "htmlReportDir": "sandbox/playwright-report",
    "tracesDir": "sandbox/test-results",
    "resultsDir": "sandbox/artifacts/playwright",
    "coverageReportPath": "sandbox/artifacts/playwright/coverage/coverage-report.json",
    "coverageDir": "sandbox/artifacts/playwright/coverage"
  }
}
