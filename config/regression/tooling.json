{
  "version": 1,
  "git": {
    "defaultBaseRef": "HEAD~1",
    "defaultHeadRef": "HEAD"
  },
  "playwright": {
    "command": "npm",
    "commandArgs": [
      "exec",
      "--prefix",
      "tools/regression-mcp",
      "--",
      "playwright"
    ],
    "defaultProject": "chromium",
    "configFile": "playwright.config.ts",
    "reportFormat": "json",
    "reportPath": "artifacts/playwright/results.json",
    "testResultsDir": "test-results",
    "htmlReportDir": "playwright-report",
    "tracesDir": "test-results",
    "resultsDir": "artifacts/playwright"
  }
}
