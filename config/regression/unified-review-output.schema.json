{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config/regression/unified-review-output.schema.json",
  "$comment": "Reference-only schema: documents the expected output shape of generate_unified_review. Not enforced at runtime.",
  "title": "UnifiedReviewOutput",
  "type": "object",
  "required": [
    "tool",
    "version",
    "generatedAt",
    "repoRoot",
    "inputs",
    "regressionReview",
    "policyCoverage",
    "overallRiskLevel",
    "overallRecommendedActions",
    "qualityGates",
    "warnings"
  ],
  "properties": {
    "tool": {
      "type": "string",
      "const": "generate_unified_review"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "repoRoot": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "required": [
        "includeUntracked",
        "changedFiles",
        "dryRun"
      ],
      "properties": {
        "baseRef": {
          "type": "string"
        },
        "headRef": {
          "type": "string"
        },
        "includeUntracked": {
          "type": "boolean"
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dryRun": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "regressionReview": {
      "$ref": "review-output.schema.json"
    },
    "policyCoverage": {
      "type": "object",
      "description": "Output of evaluate_policy_coverage tool"
    },
    "overallRiskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "overallRecommendedActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qualityGates": {
      "type": "object",
      "required": [
        "suiteCompletenessGatePassed",
        "policyCoverageGatePassed",
        "regressionRiskGatePassed",
        "combinedGatePassed"
      ],
      "properties": {
        "suiteCompletenessGatePassed": {
          "type": "boolean"
        },
        "policyCoverageGatePassed": {
          "type": "boolean"
        },
        "regressionRiskGatePassed": {
          "type": "boolean"
        },
        "combinedGatePassed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
